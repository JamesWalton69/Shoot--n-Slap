# Normalize line endings for all text files
* text=auto eol=lf

# Godot text-based files
*.gd text diff=csharp eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.res binary
*.bin binary
*.dll binary
*.so binary
*.dylib binary

# Git LFS for large 3D models and animations
*.fbx filter=lfs diff=lfs merge=lfs -text
